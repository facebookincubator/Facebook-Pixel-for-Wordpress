# Copy to .env and fill in real values. Do NOT commit .env.
# Consumed by Playwright / global-setup / seed-store.sh.

# WordPress under test (wp-env default).
WORDPRESS_URL=http://localhost:8888

# Real Meta credentials — REQUIRED for CAPI events to be sent (and thus logged).
FB_PIXEL_ID=
FB_ACCESS_TOKEN=

# Optional: a click id used by the "PageView with fbclid" test.
TEST_FBCLID=

# Logged-in customer used by the customer projects (created by env:seed).
WP_CUSTOMER_USERNAME=customer
WP_CUSTOMER_PASSWORD=customerpass
WP_CUSTOMER_EMAIL=customer@example.com

# Seeded storefront URLs (defaults match seed-store.sh).
TEST_PRODUCT_URL=/product/testp/
TEST_LEAD_FORM_URL=/e2e-lead/
